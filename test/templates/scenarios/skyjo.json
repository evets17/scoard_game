{
  "templateId": "skyjo",
  "scenarios": [
    {
      "name": "Lowest total wins after several rounds",
      "players": ["avery", "jules", "mina"],
      "rounds": [
        { "avery": 10, "jules": 20, "mina": 31 },
        { "avery": 15, "jules": 5, "mina": 12 },
        { "avery": 12, "jules": 18, "mina": 40 }
      ],
      "expected": {
        "totals": { "avery": 37, "jules": 43, "mina": 83 },
        "winners": ["avery"],
        "placements": { "avery": 1, "jules": 2, "mina": 3 }
      }
    },
    {
      "name": "Negative rounds lower a total",
      "players": ["avery", "jules"],
      "rounds": [
        { "avery": -2, "jules": 4 },
        { "avery": -6, "jules": 0 }
      ],
      "expected": {
        "totals": { "avery": -8, "jules": 4 },
        "winners": ["avery"]
      }
    },
    {
      "name": "A doubled round is entered as the doubled score",
      "players": ["avery", "jules"],
      "rounds": [
        { "avery": 24, "jules": 9 },
        { "avery": 30, "jules": 60 }
      ],
      "expected": {
        "totals": { "avery": 54, "jules": 69 },
        "winners": ["avery"]
      }
    },
    {
      "name": "Equal lowest totals tie for first",
      "players": ["avery", "jules", "mina"],
      "rounds": [
        { "avery": 30, "jules": 25, "mina": 50 },
        { "avery": 70, "jules": 75, "mina": 60 }
      ],
      "expected": {
        "totals": { "avery": 100, "jules": 100, "mina": 110 },
        "winners": ["avery", "jules"],
        "placements": { "avery": 1, "jules": 1, "mina": 3 }
      }
    },
    {
      "name": "Going out first with the lowest score outright is not doubled",
      "players": ["avery", "jules", "mina"],
      "rounds": [
        { "avery": { "round-score": 5, "first-out": 1 }, "jules": 9, "mina": 12 }
      ],
      "expected": {
        "roundScores": [{ "avery": 5, "jules": 9, "mina": 12 }],
        "roundNotes": [{}]
      }
    },
    {
      "name": "Going out first without the lowest score doubles it",
      "players": ["avery", "jules", "mina"],
      "rounds": [
        { "avery": { "round-score": 10, "first-out": 1 }, "jules": 4, "mina": 12 }
      ],
      "expected": {
        "roundScores": [{ "avery": 20, "jules": 4, "mina": 12 }],
        "roundNotes": [{ "avery": "from 10" }],
        "totals": { "avery": 20, "jules": 4, "mina": 12 }
      }
    },
    {
      "name": "Tying for lowest is not lowest outright, so it doubles",
      "players": ["avery", "jules"],
      "rounds": [
        { "avery": { "round-score": 6, "first-out": 1 }, "jules": 6 }
      ],
      "expected": {
        "roundScores": [{ "avery": 12, "jules": 6 }]
      }
    },
    {
      "name": "A negative score is never doubled",
      "players": ["avery", "jules"],
      "rounds": [
        { "avery": { "round-score": -3, "first-out": 1 }, "jules": -5 }
      ],
      "expected": {
        "roundScores": [{ "avery": -3, "jules": -5 }]
      }
    },
    {
      "name": "House rule: a negative score doubles when not lowest",
      "players": ["avery", "jules"],
      "prompts": { "double-negatives": true },
      "rounds": [
        { "avery": { "round-score": -3, "first-out": 1 }, "jules": -5 }
      ],
      "expected": {
        "roundScores": [{ "avery": -6, "jules": -5 }]
      }
    },
    {
      "name": "House rule: a negative lowest score outright is not doubled",
      "players": ["avery", "jules"],
      "prompts": { "double-negatives": true },
      "rounds": [
        { "avery": { "round-score": -5, "first-out": 1 }, "jules": -3 }
      ],
      "expected": {
        "roundScores": [{ "avery": -5, "jules": -3 }]
      }
    },
    {
      "name": "Doubling carries into the game total",
      "players": ["avery", "jules"],
      "rounds": [
        { "avery": { "round-score": 15, "first-out": 1 }, "jules": 8 },
        { "avery": 4, "jules": { "round-score": 2, "first-out": 1 } }
      ],
      "expected": {
        "roundScores": [
          { "avery": 30, "jules": 8 },
          { "avery": 4, "jules": 2 }
        ],
        "totals": { "avery": 34, "jules": 10 },
        "winners": ["jules"]
      }
    }
  ]
}
