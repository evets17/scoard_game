{
  "templateId": "rack-o",
  "scenarios": [
    {
      "name": "Highest total wins after several rounds",
      "players": ["avery", "jules", "mina"],
      "rounds": [
        { "avery": 75, "jules": 30, "mina": 45 },
        { "avery": 20, "jules": 175, "mina": 50 },
        { "avery": 125, "jules": 40, "mina": 75 }
      ],
      "expected": {
        "totals": { "avery": 220, "jules": 245, "mina": 170 },
        "winners": ["jules"],
        "placements": { "jules": 1, "avery": 2, "mina": 3 }
      }
    },
    {
      "name": "Equal totals tie for first",
      "players": ["avery", "jules"],
      "rounds": [
        { "avery": 75, "jules": 50 },
        { "avery": 25, "jules": 50 }
      ],
      "expected": {
        "totals": { "avery": 100, "jules": 100 },
        "winners": ["avery", "jules"]
      }
    }
  ],
  "pickerTotals": [
    {
      "name": "Rack-O scores 75 and says so under the score",
      "picker": "cards",
      "taps": ["Rack-O"],
      "expected": 75,
      "note": "Rack-o"
    },
    {
      "name": "75 from cards alone is not a Rack-O",
      "picker": "cards",
      "taps": ["30", "45"],
      "expected": 75,
      "note": null
    },
    {
      "name": "Rack-O with a run adds both",
      "picker": "cards",
      "taps": ["Rack-O", "Run 3"],
      "expected": 125,
      "note": "Rack-o"
    },
    {
      "name": "Cards and a run add up",
      "picker": "cards",
      "taps": ["5", "10", "Run 4"],
      "expected": 115
    }
  ]
