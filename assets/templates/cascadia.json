{
  "schemaVersion": 1,
  "id": "cascadia",
  "version": "1.0.0",
  "name": "Cascadia",
  "description": "At the end of the game, score each wildlife card, each habitat's largest corridor and its majority bonus, and every unused nature token. Highest total wins; on a tie, the player with the most nature tokens left wins.",
  "source": "https://meepletron-storage.s3.us-east-2.amazonaws.com/resources/cascadia-rulebook.pdf",
  "players": { "minimum": 1, "maximum": 4 },
  "scoringModel": "finalScore",
  "winner": "highestScore",
  "lines": [
    { "id": "bear", "label": "Bear", "entry": { "tapToEdit": true, "adjust": true } },
    { "id": "elk", "label": "Elk", "entry": { "tapToEdit": true, "adjust": true } },
    { "id": "salmon", "label": "Salmon", "entry": { "tapToEdit": true, "adjust": true } },
    { "id": "hawk", "label": "Hawk", "entry": { "tapToEdit": true, "adjust": true } },
    { "id": "fox", "label": "Fox", "entry": { "tapToEdit": true, "adjust": true } },
    {
      "id": "wildlife",
      "label": "WL",
      "formula": "{bear} + {elk} + {salmon} + {hawk} + {fox}",
      "style": { "bold": true, "ruleAbove": true }
    },
    { "id": "mountain", "label": "Mountain", "entry": { "tapToEdit": true, "adjust": true }, "style": { "shade": "#90A4AE" } },
    { "id": "forest", "label": "Forest", "entry": { "tapToEdit": true, "adjust": true }, "style": { "shade": "#2E7D32" } },
    { "id": "prairie", "label": "Prairie", "entry": { "tapToEdit": true, "adjust": true }, "style": { "shade": "#F9A825" } },
    { "id": "wetland", "label": "Wetland", "entry": { "tapToEdit": true, "adjust": true }, "style": { "shade": "#00897B" } },
    { "id": "river", "label": "River", "entry": { "tapToEdit": true, "adjust": true }, "style": { "shade": "#1E88E5" } },
    { "heading": "Bonus" },
    { "id": "mountain-bonus", "label": "Mountain", "entry": { "tapToEdit": true, "adjust": true }, "style": { "shade": "#90A4AE" } },
    { "id": "forest-bonus", "label": "Forest", "entry": { "tapToEdit": true, "adjust": true }, "style": { "shade": "#2E7D32" } },
    { "id": "prairie-bonus", "label": "Prairie", "entry": { "tapToEdit": true, "adjust": true }, "style": { "shade": "#F9A825" } },
    { "id": "wetland-bonus", "label": "Wetland", "entry": { "tapToEdit": true, "adjust": true }, "style": { "shade": "#00897B" } },
    { "id": "river-bonus", "label": "River", "entry": { "tapToEdit": true, "adjust": true }, "style": { "shade": "#1E88E5" } },
    {
      "id": "habitats",
      "label": "HA",
      "formula": "{mountain} + {forest} + {prairie} + {wetland} + {river} + {mountain-bonus} + {forest-bonus} + {prairie-bonus} + {wetland-bonus} + {river-bonus}",
      "style": { "bold": true, "ruleAbove": true }
    },
    { "id": "nature-tokens", "label": "Tokens", "entry": { "tapToEdit": true, "adjust": true } },
    {
      "id": "total",
      "label": "TOT",
      "formula": "{wildlife} + {habitats} + {nature-tokens}"
    }
  ],
  "score": "total"
}
