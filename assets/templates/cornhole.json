{
  "schemaVersion": 2,
  "id": "cornhole",
  "version": "1.2.0",
  "name": "Cornhole",
  "subtitle": "Cancellation scoring",
  "description": "Each inning, both sides throw their bags. A bag on the board is 1 point and a bag in the hole is 3. The side with more points scores the difference; the other side scores nothing. First to 21 wins.\n\nThis scores by entering both teams points for each inning.  The game will automatically calculate the points scored based on the difference.",
  "players": { "minimum": 2, "maximum": 2 },
  "scoringModel": "rounds",
  "winner": "highestScore",
  "fields": [
    {
      "id": "inning-points",
      "label": "Inning Points",
      "initialValue": 0,
      "minimumDisplayDigits": 2,
      "entry": { "tapToEdit": true, "quickAdjust": true, "replace": true, "adjust": true },
      "entryModes": [
        {
          "type": "valuePicker",
          "id": "bags",
          "label": "Bags",
          "values": [
            { "value": 0, "label": "Off", "color": "#595959" },
            { "value": 1, "label": "Board", "color": "#C8A165" },
            { "value": 3, "label": "Hole", "color": "#37474F" }
          ]
        }
      ]
    },
    {
      "id": "points-scored",
      "label": "Points Scored",
      "formula": "max(0, {inning-points} - highestOther(inning-points))"
    }
  ],
  "score": "points-scored",
  "scoreSubLabels": [
    { "when": "{points-scored} != {inning-points}", "text": "from {inning-points}" }
  ]
}
