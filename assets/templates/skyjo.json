{
  "schemaVersion": 1,
  "id": "skyjo",
  "version": "2.4.0",
  "name": "Skyjo",
  "description": "Add up each round's cards. Mark who went out first: unless they have the lowest score outright, their round score is doubled (only if it is positive). Lowest total wins. Game ends once someone reaches 100.\n\nHouse rule option: double negative scores too.",
  "source": "https://officialgamerules.org/game-rules/skyjo/",
  "players": { "minimum": 2, "maximum": 8 },
  "scoringModel": "rounds",
  "winner": "lowestScore",
  "prompts": [
    {
      "id": "double-negatives",
      "type": "boolean",
      "label": "Double negative scores",
      "help": "House rule: going out first without the lowest score doubles the round score even when it is negative.",
      "default": false
    }
  ],
  "lines": [
    {
      "id": "round-score",
      "label": "Round Score",
      "initialValue": 0,
      "minimumDisplayDigits": 2,
      "entry": { "tapToEdit": true, "quickAdjust": true, "replace": true, "adjust": true },
      "entryModes": [
        {
          "type": "valuePicker",
          "id": "cards",
          "label": "Cards",
          "values": [
            { "value": -2, "color": "#3949AB" },
            { "value": -1, "color": "#3949AB" },
            { "value": 0, "color": "#4FC3F7" },
            { "value": 1, "color": "#43A047" },
            { "value": 2, "color": "#43A047" },
            { "value": 3, "color": "#43A047" },
            { "value": 4, "color": "#43A047" },
            { "value": 5, "color": "#FDD835" },
            { "value": 6, "color": "#FDD835" },
            { "value": 7, "color": "#FDD835" },
            { "value": 8, "color": "#FDD835" },
            { "value": 9, "color": "#E53935" },
            { "value": 10, "color": "#E53935" },
            { "value": 11, "color": "#E53935" },
            { "value": 12, "color": "#E53935" }
          ]
        }
      ]
    },
    {
      "id": "first-out",
      "label": "Went out first",
      "marker": { "badge": "Out", "color": "#1565C0", "onePerRound": true }
    },
    {
      "id": "points",
      "label": "Points",
      "formula": "if({first-out} > 0 and ({round-score} > 0 or {double-negatives} > 0) and lowestOther(round-score) <= {round-score}, {round-score} * 2, {round-score})"
    }
  ],
  "score": "points",
  "scoreSubLabels": [
    { "when": "{points} != {round-score}", "text": "from {round-score}" }
  ]
}
